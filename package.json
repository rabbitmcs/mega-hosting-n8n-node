  "description": "n8n community node for MEGA cloud storage with per-credential multi-account support",
  "keywords": [
    "n8n",
    "mega",
    "mega.nz",
    "megajs",
    "cloud-storage"
  ],
  "license": "MIT",
  "author": "Rabbit",
  "homepage": "https://github.com/rabbitmcs/mega-hosting-n8n-node",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rabbitmcs/mega-hosting-n8n-node.git"
  },
  "bugs": {
    "url": "https://github.com/rabbitmcs/mega-hosting-n8n-node/issues"
  },
  "main": "index.js",
  "files": [
    "dist",
    "index.js"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
